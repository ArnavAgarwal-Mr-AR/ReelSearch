# Database (PostgreSQL / Neon Cloud URL)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Cache & Memory Protection (Redis / Redis Cloud URL - 30MB Free Tier Protection)
REDIS_URL=redis://default:password@hostname:port
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=300       # Auto-expire query cache in 5 min to avoid OOM on small memory tiers
RATE_LIMIT_PER_MINUTE=30          # Limit ingestion/save requests to 30/min per IP
SEARCH_RATE_LIMIT_PER_MINUTE=60   # Limit search requests to 60/min per IP

# Search Precision & Candidate Limits
CONFIDENCE_MIN_THRESHOLD=0.50     # Reject matches below 50% confidence
CANDIDATE_POOL_SIZE=50            # Memory-bounded candidate retrieval pool size

# Embedding Engine (sentence-transformers / openai)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional Cloud LLM Keys (leave empty to use local deterministic context extractor)
OPENAI_API_KEY=
GEMINI_API_KEY=
